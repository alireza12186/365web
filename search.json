---
layout: null
---
{% assign all_items = "" | split: "" %}
{% for post in site.posts %}
  {% capture item %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "category": {{ post.categories.first | default: "وبلاگ" | jsonify }}
    }
  {% endcapture %}
  {% assign all_items = all_items | push: item %}
{% endfor %}
{% for page in site.pages %}
  {% if page.title and page.url != "/search.json" and page.url != "/robots.txt" and page.url != "/sitemap.xml" and page.url != "/feed.xml" and page.url != "/404.html" %}
    {% unless page.url contains "assets" %}
      {% capture item %}
        {
          "title": {{ page.title | jsonify }},
          "url": {{ page.url | relative_url | jsonify }},
          "category": "خدمات"
        }
      {% endcapture %}
      {% assign all_items = all_items | push: item %}
    {% endunless %}
  {% endif %}
{% endfor %}
[{{ all_items | join: "," }}]
